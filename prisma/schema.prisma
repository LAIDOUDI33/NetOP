generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model NetworkSite {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  technology  String   // 2G, 3G, 4G, 5G
  region      String
  status      String   @default("active") // active, degraded, down, maintenance
  latitude    Float
  longitude   Float
  altitude    Float    @default(0)
  frequency   String   @default("")
  bandwidth   Float    @default(0)
  maxCapacity Int      @default(0)
  vendor      String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  kpiMetrics  KpiMetric[]
  alerts      Alert[]
  anomalies   AnomalyEvent[]
}

model KpiMetric {
  id          String      @id @default(cuid())
  siteId      String
  site        NetworkSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  technology  String
  timestamp   DateTime    @default(now())
  rssi        Float?
  rsrp        Float?
  rsrq        Float?
  sinr        Float?
  rscp        Float?
  ecno        Float?
  rxlev       Float?
  cqichannel  Float?
  downloadThroughput Float?
  uploadThroughput   Float?
  latency      Float?
  jitter       Float?
  packetLoss   Float?
  availability Float?
  activeUsers  Int?        
  handoverSuccessRate Float?
  dropRate     Float?
  blockedCallRate     Float?
  prbUtilization     Float?
  createdAt   DateTime    @default(now())

  @@index([siteId])
  @@index([technology])
  @@index([timestamp])
}

model AlertRule {
  id          String   @id @default(cuid())
  name        String
  technology  String
  metric      String
  condition   String
  threshold   Float
  severity    String   @default("warning")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  alerts      Alert[]
}

model Alert {
  id          String    @id @default(cuid())
  ruleId      String?
  rule        AlertRule?  @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  siteId      String?
  site        NetworkSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)
  technology  String
  metric      String
  value       Float
  threshold   Float
  condition   String
  severity    String
  message     String
  acknowledged Boolean  @default(false)
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([siteId])
  @@index([technology])
  @@index([severity])
  @@index([createdAt])
}

model OptimizationLog {
  id          String   @id @default(cuid())
  technology  String
  siteId      String?
  siteName    String?
  category    String
  issue       String
  recommendation String
  impact      String
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([technology])
  @@index([category])
  @@index([status])
}

model NetworkParameter {
  id          String   @id @default(cuid())
  technology  String
  parameter   String
  displayName String
  currentValue String
  unit        String   @default("")
  minRange    String?
  maxRange    String?
  description String
  category    String   @default("general")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([technology])
  @@index([category])
}

// --- ENTERPRISE-GRADE ADDITIONS ---

model SLATarget {
  id            String   @id @default(cuid())
  technology    String
  metric        String   // availability, dropRate, latency, handoverSuccessRate, prbUtilization
  targetValue   Float    // e.g., 99.5 for availability %, 50 for latency ms
  condition     String   // gte for availability, lte for latency/drop
  severity      String   @default("warning") // breach severity
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AnomalyEvent {
  id            String      @id @default(cuid())
  siteId        String?
  site          NetworkSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)
  technology    String
  metric        String
  actualValue   Float
  expectedValue Float
  zScore        Float      // statistical deviation
  severity      String      // critical, major, minor
  status        String      @default("detected") // detected, investigating, resolved, false_positive
  description   String
  resolvedAt    DateTime?
  createdAt     DateTime    @default(now())

  @@index([siteId])
  @@index([technology])
  @@index([severity])
  @@index([status])
}

model AuditLog {
  id          String   @id @default(cuid())
  entityType  String   // parameter, alert, site, anomaly
  entityId    String?
  action      String   // create, update, delete, acknowledge, resolve
  oldValue    String?
  newValue    String?
  description String
  technology  String?
  createdAt   DateTime @default(now())

  @@index([entityType])
  @@index([createdAt])
}