generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model NetworkSite {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  technology  String   // 2G, 3G, 4G, 5G
  region      String
  status      String   @default("active") // active, degraded, down, maintenance
  latitude    Float
  longitude   Float
  altitude    Float    @default(0)
  frequency   String   @default("")    // e.g., "900MHz", "2100MHz", "1800MHz", "3500MHz"
  bandwidth   Float    @default(0)      // MHz
  maxCapacity Int      @default(0)
  vendor      String   @default("")    // Ericsson, Huawei, Nokia, ZTE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  kpiMetrics  KpiMetric[]
  alerts      Alert[]
}

model KpiMetric {
  id          String      @id @default(cuid())
  siteId      String
  site        NetworkSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  technology  String
  timestamp   DateTime    @default(now())
  rssi        Float?      // Received Signal Strength Indicator (dBm)
  rsrp        Float?      // Reference Signal Received Power (dBm) - 4G/5G
  rsrq        Float?      // Reference Signal Received Quality (dB) - 4G/5G
  sinr        Float?      // Signal to Interference plus Noise Ratio (dB)
  rscp        Float?      // Received Signal Code Power (dBm) - 3G
  ecno        Float?      // Ec/N0 (dB) - 3G
  rxlev       Float?      // RX Level (dBm) - 2G
  cqichannel  Float?      // CQI (0-15) - 4G
  downloadThroughput Float?  // Mbps
  uploadThroughput   Float?  // Mbps
  latency      Float?      // ms
  jitter       Float?      // ms
  packetLoss   Float?      // percentage
  availability Float?      // percentage
  activeUsers  Int?        
  handoverSuccessRate Float? // percentage
  dropRate     Float?      // percentage
  blockedCallRate     Float? // percentage
  prbUtilization     Float? // percentage - 4G/5G
  createdAt   DateTime    @default(now())

  @@index([siteId])
  @@index([technology])
  @@index([timestamp])
}

model AlertRule {
  id          String   @id @default(cuid())
  name        String
  technology  String   // 2G, 3G, 4G, 5G, ALL
  metric      String   // e.g., "rssi", "rsrp", "downloadThroughput"
  condition   String   // "lt", "gt", "eq", "lte", "gte"
  threshold   Float
  severity    String   @default("warning") // critical, warning, info
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  alerts      Alert[]
}

model Alert {
  id          String    @id @default(cuid())
  ruleId      String?
  rule        AlertRule?  @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  siteId      String?
  site        NetworkSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)
  technology  String
  metric      String
  value       Float
  threshold   Float
  condition   String
  severity    String    // critical, warning, info
  message     String
  acknowledged Boolean  @default(false)
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([siteId])
  @@index([technology])
  @@index([severity])
  @@index([createdAt])
}

model OptimizationLog {
  id          String   @id @default(cuid())
  technology  String
  siteId      String?
  siteName    String?
  category    String   // coverage, capacity, handover, interference, parameter
  issue       String
  recommendation String
  impact      String   // high, medium, low
  status      String   @default("pending") // pending, implemented, dismissed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([technology])
  @@index([category])
  @@index([status])
}

model NetworkParameter {
  id          String   @id @default(cuid())
  technology  String
  parameter   String
  displayName String
  currentValue String
  unit        String   @default("")
  minRange    String?
  maxRange    String?
  description String
  category    String   @default("general") // rf, power, handover, capacity
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([technology])
  @@index([category])
}