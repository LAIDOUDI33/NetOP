  templateId    String
  template      ReportTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  cronExpr      String   // e.g. "0 9 * * 1" = every Monday at 9am
  timezone      String   @default("Africa/Algiers")
  format        String   @default("pdf")  // pdf, xlsx, both
  recipients    String   @default("[]") // JSON array of email addresses
  isEnabled     Boolean  @default(true)
  lastRunAt     DateTime?
  nextRunAt     DateTime?
  runCount      Int      @default(0)
  generatedBy   String?
  createdAt     DateTime @default(now())
  reports       GeneratedReport[]  @relation("ScheduleReports")

  @@index([isEnabled])
  @@index([nextRunAt])
}

model GeneratedReport {
  id            String   @id @default(cuid())
  templateId    String
  template      ReportTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  scheduleId    String?
  schedule      ReportSchedule?  @relation("ScheduleReports", fields: [scheduleId], references: [id], onDelete: SetNull)
  name          String
  type          String
  format        String   // pdf, xlsx, csv
  fileSizeBytes Int      @default(0)
  status        String   @default("completed")  // completed, failed, generating
  error         String?
  generatedBy   String?
  createdAt     DateTime @default(now())

  @@index([templateId])
  @@index([scheduleId])
  @@index([createdAt])
  @@index([status])
}

// ========== PHASE G: INTEGRATION & ECOSYSTEM MODELS ==========

model Webhook {
  id              String   @id @default(cuid())
  name            String
  url             String
  events          String   @default("[]") // JSON: ["alert.created", "incident.resolved", ...]
  secret          String   @default("")
  isEnabled       Boolean  @default(true)
  description     String   @default("")
  lastDeliveryAt  DateTime?
  successCount    Int      @default(0)
  failureCount    Int      @default(0)
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deliveries      WebhookDelivery[]

  @@index([isEnabled])
  @@index([url])
}

model WebhookDelivery {
  id              String   @id @default(cuid())
  webhookId       String
  webhook         Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event           String
  payload         String   @default("{}") // JSON
  statusCode      Int      @default(0)
  responseBody    String   @default("")
  durationMs      Int      @default(0)
  success         Boolean  @default(false)
  errorMessage    String?
  attemptCount    Int      @default(1)
  createdAt       DateTime @default(now())

  @@index([webhookId])
  @@index([event])
  @@index([success])
  @@index([createdAt])
}

// ========== MODULE 4: DIGITAL TWIN MODELS ==========

model DigitalTwinScenario {
  id            String        @id @default(cuid())
  name          String
  description   String        @default("")
  scenarioType  String        // what_if, disaster, capacity_expansion, parameter_change, new_site
  status        String        @default("draft") // draft, simulated, completed, archived
  targetRegion  String        @default("")
  targetSiteId  String?
  targetSite    NetworkSite?  @relation(fields: [targetSiteId], references: [id], onDelete: SetNull)
  parameters    String        @default("{}") // JSON: scenario-specific parameters
  results       String        @default("{}") // JSON: {before: {}, after: {}, delta: {}}
  impactScore   Float         @default(0) // -100 to +100, positive = improvement
  confidence    Float         @default(0.85)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  simulationResults SimulationResult[]

  @@index([scenarioType])
  @@index([status])
  @@index([targetRegion])
}

model SimulationResult {
  id          String              @id @default(cuid())
  scenarioId  String
  scenario    DigitalTwinScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  metricName  String
  beforeValue Float
  afterValue  Float
  deltaValue  Float
  deltaPct    Float
  unit        String              @default("")
  direction   String              @default("neutral") // improved, degraded, neutral
  createdAt   DateTime            @default(now())

  @@index([scenarioId])
  @@index([metricName])
  @@index([direction])
}

// ========== MODULE 1: PREDICTIVE ANALYTICS MODELS ==========

model ChurnPrediction {
  id                  String   @id @default(cuid())
  wilaya              String
  segmentName         String   // consumer, enterprise, youth, corporate, prepaid, postpaid
  technology          String   @default("ALL")
  totalSubscribers    Int      @default(0)
  atRiskCount         Int      @default(0)
  highRiskCount       Int      @default(0)
  churnRate           Float    @default(0)
  predictedChurnRate  Float    @default(0)
  churnTrend          String   @default("stable") // increasing, stable, decreasing
  drivers             String   @default("[]") // JSON: [{name, impact, weight}]
  confidence          Float    @default(0.8)
  revenueAtRisk       Int      @default(0)
  predictionDate      DateTime @default(now())
  horizon             String   @default("30d")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([wilaya])
  @@index([segmentName])
  @@index([churnTrend])
  @@index([horizon])
}

model TrafficForecast {
  id                  String   @id @default(cuid())
  region              String
  technology          String
  metric              String   // dataVolumeGB, voiceMinutes, sessions, activeUsers
  currentDailyAvg     Float    @default(0)
  forecastedDailyAvg  Float    @default(0)
  growthRate          Float    @default(0)
  peakHour            String   @default("20:00")
  peakDay             String   @default("Friday")
  seasonality         String   @default("moderate")
  forecastPoints      String   @default("[]") // JSON: [{date, predicted, lower, upper}]
  horizon             String   @default("30d")
  confidence          Float    @default(0.85)
  trendDirection      String   @default("growing")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([region])
  @@index([technology])
  @@index([metric])
  @@index([horizon])
}

model RevenueProjection {
  id                  String   @id @default(cuid())
  segment             String   // consumer, enterprise, wholesale, mvno
  metric              String   // revenue, arpu, subscriberCount
  currentMonthly      Float    @default(0)
  forecastPoints      String   @default("[]") // JSON: [{month, value, lower, upper}]
  growthRate          Float    @default(0)
  annualGrowthRate    Float    @default(0)
  confidence          Float    @default(0.85)
  riskFactors         String   @default("[]") // JSON: [{name, probability, impact}]
  trendDirection      String   @default("growing")
  seasonalityIndex    Float    @default(1.0)
  horizon             String   @default("6m")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([segment])
  @@index([metric])
  @@index([horizon])
}

model ApiKey {
  id              String   @id @default(cuid())
  name            String
  keyHash         String   @unique
  keyPrefix       String   // first 8 chars for display
  permissions     String   @default("[\"*\"]") // JSON: ["alerts:*", "kpi:view", ...]
  isEnabled       Boolean  @default(true)
  expiresAt       DateTime?
  lastUsedAt      DateTime?
  requestCount    Int      @default(0)
  description     String   @default("")
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isEnabled])
  @@index([keyPrefix])
  @@index([createdBy])
}
