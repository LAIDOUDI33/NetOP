generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model NetworkSite {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  technology  String
  region      String
  status      String   @default("active")
  latitude    Float
  longitude   Float
  altitude    Float    @default(0)
  frequency   String   @default("")
  bandwidth   Float    @default(0)
  maxCapacity Int      @default(0)
  vendor      String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  kpiMetrics    KpiMetric[]
  alerts        Alert[]
  anomalies     AnomalyEvent[]
  neighbors     NeighborRelation[]
  sonActions    SonAction[]
  qoeMetrics    QoEMetric[]
  capacityForecasts CapacityForecast[]
  networkSlices NetworkSlice[]
  energyMetrics  EnergyMetric[]
  faultPredictions FaultPrediction[]
  incidents      Incident[]
}

model KpiMetric {
  id          String      @id @default(cuid())
  siteId      String
  site        NetworkSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  technology  String
  timestamp   DateTime    @default(now())
  rssi        Float?
  rsrp        Float?
  rsrq        Float?
  sinr        Float?
  rscp        Float?
  ecno        Float?
  rxlev       Float?
  cqichannel  Float?
  downloadThroughput Float?
  uploadThroughput   Float?
  latency      Float?
  jitter       Float?
  packetLoss   Float?
  availability Float?
  activeUsers  Int?
  handoverSuccessRate Float?
  dropRate     Float?
  blockedCallRate     Float?
  prbUtilization     Float?
  createdAt   DateTime    @default(now())

  @@index([siteId])
  @@index([technology])
  @@index([timestamp])
}

model AlertRule {
  id          String   @id @default(cuid())
  name        String
  technology  String
  metric      String
  condition   String
  threshold   Float
  severity    String   @default("warning")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  alerts      Alert[]
}

model Alert {
  id            String      @id @default(cuid())
  ruleId        String?
  rule          AlertRule?  @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  siteId        String?
  site          NetworkSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)
  technology    String
  metric        String
  value         Float
  threshold     Float
  condition     String
  severity      String
  message       String
  acknowledged  Boolean     @default(false)
  correlatedGroupId String?   // groups related alerts together
  resolvedAt    DateTime?
  createdAt     DateTime     @default(now())

  @@index([siteId])
  @@index([technology])
  @@index([severity])
  @@index([createdAt])
  @@index([correlatedGroupId])
}

model OptimizationLog {
  id          String   @id @default(cuid())
  technology  String
  siteId      String?
  siteName    String?
  category    String
  issue       String
  recommendation String
  impact      String
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([technology])
  @@index([category])
  @@index([status])
}

model NetworkParameter {
  id          String   @id @default(cuid())
  technology  String
  parameter   String
  displayName String
  currentValue String
  unit        String   @default("")
  minRange    String?
  maxRange    String?
  description String
  category    String   @default("general")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([technology])
  @@index([category])
}

model SLATarget {
  id            String   @id @default(cuid())
  technology    String
  metric        String
  targetValue   Float
  condition     String
  severity      String   @default("warning")
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AnomalyEvent {
  id            String      @id @default(cuid())
  siteId        String?
  site          NetworkSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)
  technology    String
  metric        String
  actualValue   Float
  expectedValue Float
  zScore        Float
  severity      String
  status        String      @default("detected")
  description   String
  resolvedAt    DateTime?
  createdAt     DateTime    @default(now())

  @@index([siteId])
  @@index([technology])
  @@index([severity])
  @@index([status])
}

model AuditLog {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String?
  action      String
  oldValue    String?
  newValue    String?
  description String
  technology  String?
  createdAt   DateTime @default(now())

  @@index([entityType])
  @@index([createdAt])
}

// ========== PHASE A: SON & AUTOMATION MODELS ==========

model SonModule {
  id            String   @id @default(cuid())
  name          String   // ANR, PCI, MRO, CCO, HLB, CODC, AIC, PnP
  displayName   String
  technology    String   // 2G, 3G, 4G, 5G, ALL
  description   String
  enabled       Boolean  @default(true)
  mode          String   @default("semi-automated") // open-loop, semi-automated, closed-loop
  schedule      String?  // cron expression or "always"
  parameters    String   @default("{}") // JSON: module-specific config
  stats         String   @default("{}") // JSON: {actions24h, successRate, avgImpact}
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  actions       SonAction[]
}

model SonAction {
  id              String      @id @default(cuid())
  moduleId        String
  module          SonModule   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  siteId          String?
  site            NetworkSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)
  technology      String
  actionType      String      // add_neighbor, remove_neighbor, modify_pci, adjust_tilt, adjust_power, compensate_outage, correct_config
  parameter       String      // which param was changed
  previousValue   String
  newValue        String
  reason          String
  status          String      @default("pending") // pending, applied, rolled_back, failed
  kpiBefore       String      @default("{}") // JSON snapshot of KPIs before action
  kpiAfter        String?     // JSON snapshot of KPIs after action
  impactScore     Float?      // computed improvement
  rollbackReason  String?
  appliedAt       DateTime?
  rolledBackAt    DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([moduleId])
  @@index([siteId])
  @@index([technology])
  @@index([status])
  @@index([createdAt])
}

model NeighborRelation {
  id              String      @id @default(cuid())
  servingCellId   String
  servingCell     NetworkSite @relation(fields: [servingCellId], references: [id], onDelete: Cascade)
  neighborCellId  String
  neighborCellName String
  neighborCellCode String
  technology      String
  relationType    String  // intra_freq, inter_freq, inter_tech
  hoType          String  @default("manual") // manual, anr_auto, pnp_auto
  status          String  @default("active") // active, removed, blacklisted
  hoSuccessRate   Float?
  lastUpdated     DateTime @default(now())

  @@index([servingCellId])
  @@index([technology])
}

model Policy {
  id            String   @id @default(cuid())
  name          String
  description   String
  technology    String   // ALL for cross-tech
  triggerType   String   // kpi_breach, anomaly_detected, schedule, manual
  triggerConfig String   @default("{}") // JSON: {metric, condition, threshold} or {cron}
  actionModules String   @default("[]") // JSON: array of SON module IDs to execute
  scope         String   @default("all") // all, region, site, cluster
  scopeValue    String?  // region name or site ID
  priority      Int      @default(5) // 1=highest
  enabled       Boolean  @default(true)
  cooldownMins  Int      @default(30)
  stats         String   @default("{}") // JSON: {totalRuns, successRate, lastRun}
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  executions    PolicyExecution[]
}

model PolicyExecution {
  id            String   @id @default(cuid())
  policyId      String
  policy        Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  status        String   @default("triggered") // triggered, running, completed, failed, rolled_back
  triggerReason String
  affectedSites String   @default("[]") // JSON: site IDs
  actionsTaken  String   @default("[]") // JSON: SonAction IDs
  kpiImpact     String   @default("{}") // JSON: before/after KPI summary
  rollbackReason String?
  durationMs    Int?
  createdAt     DateTime @default(now())
  completedAt   DateTime?

  @@index([policyId])
  @@index([status])
  @@index([createdAt])
}

model QoEMetric {
  id              String      @id @default(cuid())
  siteId          String
  site            NetworkSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  technology      String
  timestamp       DateTime    @default(now())
  mosScore        Float?      // Mean Opinion Score 1-5
  dataRateExperienced Float?  // Actual user throughput (Mbps)
  callSetupTime   Float?      // Seconds
  callDropRate    Float?      // %
  webPageLoadTime Float?      // Seconds
  videoStartTime  Float?      // Seconds
  pingLatency     Float?      // ms
  jitterExperience Float?     // ms
  satisfactionIndex Float?    // 0-100 composite
  subscriberCount Int?
  complaintCount  Int         @default(0)
  createdAt       DateTime    @default(now())

  @@index([siteId])
  @@index([technology])
  @@index([timestamp])
}

model VendorProfile {
  id          String   @id @default(cuid())
  vendor      String   @unique // Ericsson, Huawei, Nokia, Samsung, ZTE
  displayName String
  technologies String   @default("[]") // JSON: supported techs
  apiType     String   @default("rest") // rest, netconf, snmp, cli
  apiEndpoint String?
  credentials  String?  // encrypted reference (not actual creds)
  status      String   @default("active") // active, disconnected, error
  lastSync    DateTime?
  stats       String   @default("{}") // JSON: {sitesManaged, lastActionCount, syncStatus}
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteOnboarding {
  id          String   @id @default(cuid())
  siteName    String
  siteCode    String   @unique
  technology  String
  region      String
  vendor      String
  latitude    Float
  longitude   Float
  altitude    Float    @default(0)
  frequency   String   @default("")
  bandwidth   Float    @default(0)
  maxCapacity Int      @default(0)
  status      String   @default("pending") // pending, provisioning, configuring, verifying, completed, failed
  assignedPci String?
  assignedFreq String?
  initialNeighbors String  @default("[]") // JSON: neighbor site codes
  kpiBaseline String   @default("{}") // JSON: first KPI readings
  errorMessage String?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([technology])
  @@index([createdAt])
}

// ========== PHASE B: ADVANCED INTELLIGENCE & OPERATIONS ==========

model CapacityForecast {
  id            String   @id @default(cuid())
  siteId        String?
  site          NetworkSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)
  technology    String
  region        String
  metric        String   // prbUtilization, activeUsers, throughput
  currentValue  Float
  forecastValue Float
  forecastHorizon String   @default("7d") // 7d, 14d, 30d, 90d
  growthRate    Float    // percentage growth predicted
  capacityLimit  Float?
  utilizationAtLimit Float? // predicted utilization when capacity is reached
  confidence    Float    @default(0.85) // 0-1 prediction confidence
  riskLevel     String   @default("low") // low, medium, high, critical
  recommendation String   @default("")
  timestamp     DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([siteId])
  @@index([technology])
  @@index([region])
  @@index([riskLevel])
  @@index([timestamp])
}

model NetworkSlice {
  id            String   @id @default(cuid())
  name          String
  sliceType     String   // eMBB, URLLC, mMTC
  technology    String   @default("5G")
  status        String   @default("active") // active, suspended, deactivated
  siteId        String?
  site          NetworkSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)
  sst           String?  // S-NSSAI SST
  sd            String?  // S-NSSAI SD
  maxBandwidth  Float    @default(100) // Mbps
  guaranteedBw  Float    @default(30)  // Mbps guaranteed
  maxUsers     Int      @default(100)
  priorityLevel Int      @default(5)  // 1=highest
  latencyTarget Float?  // ms
  reliabilityTarget Float? // 99.999 etc
  currentLoad  Float    @default(0)   // percentage
  activeUsers  Int      @default(0)
  avgThroughput Float?
  avgLatency   Float?
  qci           Int?     // QoS Class Identifier
  FiveQi        Int?     // 5G QoS Identifier
  parameters    String   @default("{}") // JSON: slice-specific params
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([siteId])
  @@index([technology])
  @@index([status])
  @@index([sliceType])
}

model EnergyMetric {
  id              String      @id @default(cuid())
  siteId          String
  site            NetworkSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  technology      String
  timestamp       DateTime    @default(now())
  powerConsumption Float      // Watts
  energyConsumed  Float      // Wh in the interval
  activeUsers     Int?
  trafficLoad     Float?     // PRB utilization %
  temperature     Float?     // Celsius
  sleepMode       Boolean     @default(false)
  mode            String      @default("normal") // normal, energy_saving, sleep, shutdown
  co2Emission     Float?     // kg CO2 equivalent
  solarGeneration  Float?     // Watts from solar
  batteryLevel    Float?     // % if battery backup
  createdAt       DateTime    @default(now())

  @@index([siteId])
  @@index([technology])
  @@index([timestamp])
  @@index([mode])
}

model FaultPrediction {
  id              String   @id @default(cuid())
  siteId          String?
  site            NetworkSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)
  technology      String
  component       String   // RRU, BBU, PSU, Antenna, Fiber, Transport
  faultType       String   // hardware_failure, software_bug, degradation, power_issue, environmental
  probability      Float    // 0-1 predicted probability
  severity        String   @default("medium") // low, medium, high, critical
  status          String   @default("predicted") // predicted, confirmed, mitigated, false_positive
  confidence      Float    @default(0.0)
  indicators      String   @default("[]") // JSON: list of contributing KPIs
  recommendedAction String   @default("")
 estimatedTimeToFail String?  // e.g. "72h", "7d", "30d"
  resolvedAt      DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([siteId])
  @@index([technology])
  @@index([severity])
  @@index([status])
  @@index([component])
}

model SubscriberSegment {
  id              String   @id @default(cuid())
  segmentName     String
  technology      String
  criteria        String   @default("{}") // JSON: {dataRange, usagePattern, location, deviceType}
  subscriberCount Int      @default(0)
  avgDataUsage    Float    @default(0) // GB per month
  avgVoiceMinutes Float    @default(0) // minutes per month
  arpu            Float    @default(0) // Average Revenue Per User
  churnRisk       Float    @default(0) // 0-1
  satisfactionScore Float?  // 0-100
  topServices     String   @default("[]") // JSON: ["video_streaming", "social_media", ...]
  peakHour       String?  // e.g. "20:00-23:00"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([technology])
}

model Incident {
  id              String   @id @default(cuid())
  title           String
  description     String   @default("")
  technology      String
  siteId          String?
  site            NetworkSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)
  severity        String   @default("medium") // low, medium, high, critical
  status          String   @default("open") // open, investigating, resolved, closed
  category        String   @default("network") // network, hardware, software, power, environmental, third_party
  priority        Int      @default(5)  // 1=highest
  assignedTo      String?
  reportedBy      String   @default("system")
  mttrTarget      Int?     // minutes
  mtbfValue      Float?   // hours
  rootCause       String?
  resolution      String?
  affectedSites   String   @default("[]") // JSON: site IDs
  relatedAlerts   String   @default("[]") // JSON: alert IDs
  tags            String   @default("[]") // JSON: ["capacity", "interference", ...]
  slaBreach       Boolean   @default(false)
  resolvedAt      DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([siteId])
  @@index([technology])
  @@index([severity])
  @@index([status])
  @@index([category])
  @@index([priority])
  @@index([createdAt])
}

model ConfigTemplate {
  id              String   @id @default(cuid())
  name            String
  technology      String
  category        String   @default("general") // radio, neighbor, handover, power, capacity
  description     String   @default("")
  vendor          String   @default("")
  parameters      String   @default("{}") // JSON: {paramName: {value, unit, range}}
  isDefault       Boolean @default(false)
  applyCount      Int      @default(0)
  lastApplied     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}