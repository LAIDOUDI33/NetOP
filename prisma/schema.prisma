// ============================================================
// National SOC Platform - Enterprise Database Schema
// Version: 2.0.0 (Simplified Relations)
// Models: 27 | Domains: Auth, Core SOC, Threat Intel, Telecom, Compliance
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// DOMAIN 1: AUTHENTICATION & AUTHORIZATION
// ============================================================

model User {
  id                String           @id @default(cuid())
  email             String           @unique
  username          String           @unique
  passwordHash      String
  name              String
  avatarUrl         String?
  isActive          Boolean          @default(true)
  isMfaEnabled      Boolean          @default(false)
  mfaSecret         String?
  lastLoginAt       DateTime?
  passwordChangedAt DateTime         @default(now())
  roleId            String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  // LDAP/Active Directory Integration
  ldapDN            String?          @map("ldap_dn")           // Full Distinguished Name
  ldapGUID          String?          @map("ldap_guid")         // Globally Unique Identifier (objectGuid)
  ldapSID           String?          @map("ldap_sid")          // Security Identifier
  employeeId        String?          @map("employee_id")       // Corporate employee ID
  department        String?                              // Department from LDAP/AD
  title             String?                               // Job title
  managerDN         String?          @map("manager_dn")       // Manager's DN
  lastLDAPSyncAt    DateTime?        @map("last_ldap_sync_at")// Last sync timestamp

  // SAML SSO Integration
  samlNameID        String?          @map("saml_name_id")     // Persistent NameID from IdP
  samlSessionIndex  String?          @map("saml_session_index")// Session index for SLO
  lastSAMLLoginAt   DateTime?        @map("last_saml_login_at")// Last SSO login time
  preferredIdP      String?          @map("preferred_idp")    // Preferred Identity Provider
  
  // Authentication Method Tracking
  authMethod        String           @default("local")        // local | ldap | saml
  lastAuthMethod    String?          @map("last_auth_method") // Last used auth method
  loginCount        Int              @default(0)              // Total successful logins
  failedLoginCount  Int              @default(0) @map("failed_login_count")
  lastFailedLoginAt DateTime?       @map("last_failed_login_at")

  // Security Flags
  isPasswordExpired Boolean          @default(false) @map("is_password_expired")
  isAccountLocked  Boolean          @default(false) @map("is_account_locked")
  mustChangePassword Boolean        @default(false) @map("must_change_password")
  
  // Djezzy-Specific Fields
  djezzyCostCenter  String?          @map("djezzy_cost_center")
  djezzyLocation    String?          @map("djezzy_location")
  djezzyBadgeNumber String?          @map("djezzy_badge_number")
  djezzyClearanceLevel String?       @map("djezzy_clearance_level")

  // Relations
  role              Role             @relation(fields: [roleId], references: [id])
  sessions          Session[]
  auditLogs         AuditLog[]
  tasks             Task[]
  incidentUpdates   IncidentUpdate[]

  @@index([email])
  @@index([username])
  @@index([roleId])
  @@index([authMethod])
  @@index([samlNameID])
  @@index([ldapGUID])
}

model Role {
  id            String        @id @default(cuid())
  name          String        @unique
  description   String
  users         User[]

  @@map("roles")
}

model Session {
  id            String    @id @default(cuid())
  userId        String
  token         String    @unique
  refreshToken  String?    @unique
  ipAddress     String?
  userAgent     String?
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("sessions")
}

// ============================================================
// DOMAIN 2: CORE SOC - ALERTS & INCIDENTS
// ============================================================

model Alert {
  id                  String           @id @default(cuid())
  title               String
  description         String?
  severity            AlertSeverity    @default(MEDIUM)
  status              AlertStatus      @default(NEW)
  alertType           AlertType        @default(DETECTION)
  source              String
  rawEvent            String?
  sourceIp            String?
  destIp              String?
  sourcePort          Int?
  destPort            Int?
  protocol            String?
  mitreTactics        String?
  mitreTechniques     String?
  iocIds              String?
  incidentId          String?
  assignedToId        String?
  escalationCount     Int              @default(0)
  suppressionRuleId   String?
  isSuppressed        Boolean          @default(false)
  resolvedAt          DateTime?
  firstSeen           DateTime         @default(now())
  lastSeen            DateTime         @default(now())
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  incident            Incident?        @relation(fields: [incidentId], references: [id])

  @@index([status])
  @@index([severity])
  @@index([alertType])
  @@index([incidentId])
  @@index([assignedToId])
  @@index([firstSeen])
  @@index([isSuppressed])
}

enum AlertSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum AlertStatus {
  NEW
  ACKNOWLEDGED
  IN_PROGRESS
  ESCALATED
  RESOLVED
  FALSE_POSITIVE
  SUPPRESSED
}

enum AlertType {
  DETECTION
  CORRELATION
  ANOMALY
  THREAT_FEED
  COMPLIANCE
  MANUAL
}

model Incident {
  id                  String           @id @default(cuid())
  title               String
  description         String?
  incidentType        IncidentType     @default(SECURITY)
  severity            IncidentSeverity @default(HIGH)
  status              IncidentStatus   @default(OPEN)
  priority            Int              @default(3)
  phase               IncidentPhase    @default(DETECTION)
  tatcCode            String?
  impactScore         Float            @default(0.0)
  confidenceScore     Float            @default(0.0)
  assignedToId        String?
  reportedBy          String?
  rootCauseAnalysis   String?
  lessonsLearned      String?
  communicationLog    String?
  affectedAssets      String?
  affectedServices    String?
  blastRadius         String?
  containmentStrategy String?
  eradicationSteps    String?
  recoverySteps       String?
  detectedAt          DateTime         @default(now())
  resolvedAt          DateTime?
  targetResolution    DateTime?
  slaBreach           Boolean          @default(false)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  alerts              Alert[]
  updates             IncidentUpdate[]
  evidence            Evidence[]
  tasks               Task[]

  @@index([status])
  @@index([severity])
  @@index([incidentType])
  @@index([assignedToId])
  @@index([detectedAt])
  @@index([slaBreach])
}

enum IncidentType {
  SECURITY
  FRAUD
  DATA_BREACH
  DDoS
  MALWARE
  PHISHING
  INSIDER_THREAT
  THIRD_PARTY
  TELECOM_FRAUD
  INTERCEPTION
  NETWORK_INTRUSION
  APT
}

enum IncidentSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum IncidentStatus {
  OPEN
  IN_PROGRESS
  CONTAINED
  ERADICATED
  RECOVERING
  RESOLVED
  CLOSED
  POST_MORTEM
}

enum IncidentPhase {
  DETECTION
  ANALYSIS
  CONTAINMENT
  ERADICATION
  RECOVERY
  LESSONS_LEARNED
  CLOSED
}

model IncidentUpdate {
  id          String    @id @default(cuid())
  incidentId  String
  authorId    String
  message     String
  status      IncidentStatus?
  phase       IncidentPhase?
  isInternal  Boolean   @default(false)
  attachments String?
  createdAt   DateTime  @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  author   User    @relation(fields: [authorId], references: [id])

  @@index([incidentId])
  @@index([authorId])
  @@map("incident_updates")
}

model Evidence {
  id          String        @id @default(cuid())
  incidentId  String
  title       String
  description String?
  type        EvidenceType  @default(FILE)
  filePath    String?
  fileHash    String?
  fileSize    Int?
  mimeType    String?
  collectedBy String?
  collectedAt DateTime     @default(now())
  metadata    String?
  createdAt   DateTime      @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@index([type])
  @@map("evidence")
}

enum EvidenceType {
  FILE
  LOG
  MEMORY_DUMP
  NETWORK_CAPTURE
  SCREENSHOT
  EMAIL
  MALWARE_SAMPLE
  CONFIGURATION
  OTHER
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      TaskStatus @default(PENDING)
  priority    Int        @default(3)
  assigneeId  String?
  incidentId  String?
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  assignee  User?     @relation(fields: [assigneeId], references: [id])
  incident Incident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([assigneeId])
  @@index([incidentId])
  @@index([dueDate])
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

// ============================================================
// DOMAIN 3: THREAT INTELLIGENCE
// ============================================================

model ThreatIndicator {
  id                String              @id @default(cuid())
  type              IndicatorType
  value             String
  confidence        Float               @default(50.0)
  source            String?
  threatActor       String?
  malwareFamily     String?
  campaignId        String?
  isFirstSeen      Boolean             @default(true)
  isActive          Boolean             @default(true)
  ttl               DateTime?
  lastSeen          DateTime            @default(now())
  firstSeen         DateTime            @default(now())
  tags              String?
  context           String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt()

  @@unique([type, value])
  @@index([type])
  @@index([isActive])
  @@index([threatActor])
  @@map("threat_indicators")
}

enum IndicatorType {
  IPV4
  IPV6
  DOMAIN
  URL
  EMAIL
  FILE_HASH_MD5
  FILE_HASH_SHA1
  FILE_HASH_SHA256
  MUTEX
  REGISTRY_KEY
  USER_AGENT
  SS7_GT
  SS7_IMSI
  IMSI
  IMEI
  MSISDN
  PHONE_NUMBER
}

model IOC {
  id                String           @id @default(cuid())
  iocId             String           @unique
  type              IndicatorType
  value             String
  threatLevel       ThreatLevel      @default(MEDIUM)
  description       String?
  source            String?
  sourceUrl         String?
  confidence        Int              @default(50)
  createdBy         String?
  killChainPhases   String?
  labels            String?
  isValidated       Boolean          @default(false)
  falsePositiveRate Float            @default(0.0)
  lastObserved      DateTime?
  expiration        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt()

  @@index([type])
  @@index([threatLevel])
  @@index([isValidated])
}

enum ThreatLevel {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  UNKNOWN
}

model TIPLv2 {
  id                  String           @id @default(cuid())
  tipId               String           @unique
  title               String
  type                TIPLv2Type
  description         String?
  confidence          Float            @default(50.0)
  severity            TIPSeverity      @default(MEDIUM)
  sourceOrg           String?
  tlp                 TLPMarking       @default(AMBER)
  iocIds              String?
  indicatorIds        String?
  productIds          String?
  affectedCountries   String?
  affectedSectors     String?
  telecomSpecific     String?
  isActionable        Boolean          @default(false)
  actionTaken         String?
  distributionScope   DistributionScope @default(NATIONAL_SOC)
  publishedAt         DateTime?
  validFrom           DateTime         @default(now())
  validUntil         DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt()

  @@index([type])
  @@index([severity])
  @@index([tlp])
  @@index([isActionable])
  @@map("tipl_v2")
}

enum TIPLv2Type {
  INDICATOR
  OBSERVABLE
  CAMPAIGN
  THREAT_ACTOR
  MALWARE
  VULNERABILITY
  ATTACK_PATTERN
  COURSE_OF_ACTION
  INFRASTRUCTURE
  TELECOM_THREAT
}

enum TIPSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum TLPMarking {
  RED
  AMBER
  GREEN
  WHITE
  CLEAR
}

enum DistributionScope {
  NATIONAL_SOC
  SECTOR_CSIRTs
  CRITICAL_INFRASTRUCTURE
  ALL_STAKEHOLDERS
  INTERNATIONAL_PARTNERS
  PUBLIC
}

model Campaign {
  id                String           @id @default(cuid())
  name              String           @unique
  alias             String?
  description       String?
  threatActor       String?
  attributionConfidence Float        @default(0.0)
  status            CampaignStatus   @default(ACTIVE)
  startDate         DateTime?
  endDate           DateTime?
  targetSector      String?
  targetRegion      String?
  objectives        String?
  techniques        String?
  milestones        String?
  financialImpact   Float?
  isActive          Boolean          @default(true)
  firstSeen         DateTime         @default(now())
  lastSeen         DateTime         @default(now())
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt()

  @@index([status])
  @@index([threatActor])
  @@index([isActive])
}

enum CampaignStatus {
  ACTIVE
  DORMANT
  CONCLUDED
  ATTRIBUTED
  ONGOING
}

// ============================================================
// DOMAIN 4: TELECOM-SPECIFIC MODELS (SIMIFIED)
// ============================================================

model Subscriber {
  id                String           @id @default(cuid())
  imsi              String           @unique
  msisdn            String           @unique
  imei              String?
  imsiType          IMSIType         @default(POSTPAID)
  subscriberStatus  SubscriberStatus @default(ACTIVE)
  roamingStatus     RoamingStatus    @default(HOME)
  homeCountry       String?
  visitedCountry    String?
  visitedNetwork    String?
  profile           String?
  riskScore         Float            @default(0.0)
  lastLocationUpdate DateTime?
  lastActivityAt    DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt()

  @@index([imsi])
  @@index([msisdn])
  @@index([subscriberStatus])
  @@index([riskScore])
}

enum IMSIType {
  PREPAID
  POSTPAID
  MVNO
  ROAMING
  IoT
  MACHINE
}

enum SubscriberStatus {
  ACTIVE
  SUSPENDED
  TERMINATED
  FRAUD_LOCKED
  BARRED
  PENDING_ACTIVATION
}

enum RoamingStatus {
  HOME
  INTERNATIONAL_ROAMING
  NATIONAL_ROAMING
  UNKNOWN
}

model NetworkElement {
  id                String           @id @default(cuid())
  elementType       NetworkElementType
  hostname          String
  ipAddress         String           @unique
  vendor            String?
  softwareVersion   String?
  status            NEStatus         @default(OPERATIONAL)
  capacity          Float?
  location          String?
  redundancyGroup   String?
  protocols         String?
  securityZone      String?
  configHash        String?
  metadata          String?
  lastHeartbeat     DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt()

  @@index([elementType])
  @@index([status])
  @@index([ipAddress])
  @@map("network_elements")
}

enum NetworkElementType {
  HLR_HSS
  MSC
  SGSN
  GGSN_PGW
  MME
  SMSC
  STP
  SIGTRAN_GATEWAY
  GTP_PROXY
  DIAMETER_AGENT
  SIP_PROXY
  CSCF_P_CSCF
  CSCF_I_CSCF
  CSCF_S_CSCF
  PCRF_OCS
  CDR_COLLECTOR
  PROBE_SENSOR
  FIREWALL
  IDS_IPS
  LOAD_BALANCER
}

enum NEStatus {
  OPERATIONAL
  DEGRADED
  MAINTENANCE
  FAILED
  OFFLINE
  UNKNOWN
}

model SS7Message {
  id                String           @id @default(cuid())
  messageType       SS7MessageType
  opc               Int
  dpc               Int
  globalTitle       String?
  imsi              String?
  msisdn            String?
  sriResult         String?
  isRoaming         Boolean          @default(false)
  isInternational   Boolean          @default(false)
  anomalyScore      Float            @default(0.0)
  anomalyReason     String?
  isBlocked         Boolean          @default(false)
  rawMessage        String?
  protocolDetails   String?
  sourceNeId        String?
  destNeId          String?
  timestamp         DateTime         @default(now())
  processedAt       DateTime?

  @@index([messageType])
  @@index([opc, dpc])
  @@index([timestamp])
  @@index([anomalyScore])
  @@index([isBlocked])
  @@map("ss7_messages")
}

enum SS7MessageType {
  SRI_REQ
  SRI_RESP
  ISI_REQ
  ISI_RESP
  MAP_INSERT_SUB_DATA
  MAP_UPDATE_LOCATION
  MAP_CANCEL_LOCATION
  MAP_PURGE_MS
  MAP_NOTIFY_FWD_SHORT_MSG
  MAP_FWD_SHORT_MSG
  MAP_DEL_SM_REQ
  MAP_DEL_SM_RESP
  MAP_ALERT_SERVICE
  MAP_PROCESS_SS_REQ
  MAP_REGISTER_SS
  MAP_ERASE_SS
  USSD_REQUEST
  OTHER
}

model GTPSession {
  id                String           @id @default(cuid())
  sessionType       GTPSessionType
  imsi              String?
  msisdn            String?
  imei              String?
  sourceIp          String
  destIp            String
  sourceTeid        BigInt
  destTeid          BigInt
  apn               String?
  rai               String?
  cellId            String?
  lac               Int?
  mcc               String?
  mnc               String?
  qosProfile        String?
  bytesUp           BigInt           @default(0)
  bytesDown         BigInt           @default(0)
  durationSeconds   Int              @default(0)
  chargingId        String?
  pdnType           PDNType          @default(IPV4)
  sessionStatus     SessionStatus    @default(ACTIVE)
  ratType           RATType?
  anomalyScore      Float            @default(0.0)
  startedAt         DateTime         @default(now())
  lastActivityAt    DateTime         @default(now())
  terminatedAt      DateTime?

  @@index([imsi])
  @@index([sessionType])
  @@index([sessionStatus])
  @@index([startedAt])
  @@map("gtp_sessions")
}

enum GTPSessionType {
  DATA
  CONTROL
  SIGNALING
}

enum PDNType {
  IPV4
  IPV6
  IPV4V6
}

enum SessionStatus {
  ACTIVE
  IDLE
  TERMINATED
  SUSPENDED
}

enum RATType {
  GERAN
  UTRAN
  EUTRAN
  NR
  WLAN
  UNKNOWN
}

model DiameterSession {
  id                String              @id @default(cuid())
  sessionId         String              @unique
  commandCode       DiameterCommand
  originHost        String
  originRealm       String
  destinationHost   String?
  destinationRealm  String?
  authApplicationId Int?
  userName          String?
  imsi              String?
  resultCode        Int?
  isError           Boolean             @default(false)
  errorReason       String?
  ccRequestType    CCRequestType?
  ccRequestNumber  Int                 @default(0)
  serviceInfo       String?
  subscriptionId    String?
  ratedUnits        BigInt              @default(0)
  currencyCode      String?
  sessionStatus     SessionStatus       @default(ACTIVE)
  anomalyScore      Float               @default(0.0)
  startedAt         DateTime            @default(now())
  lastActivityAt    DateTime            @default(now())
  terminatedAt      DateTime?

  @@index([sessionId])
  @@index([commandCode])
  @@index([userName])
  @@index([sessionStatus])
  @@map("diameter_sessions")
}

enum DiameterCommand {
  CCR
  CCA
  AAR
  AAA
  STR
  STA
  ASR
  ASA
  DER
  DEA
  UDR
  UDA
  PUR
  PUA
  RAR
  RAA
  OTHER
}

enum CCRequestType {
  INITIAL_REQUEST
  UPDATE_REQUEST
  TERMINATION_REQUEST
  EVENT_REQUEST
}

model RadiusSession {
  id                String           @id @default(cuid())
  sessionId         String           @unique
  userName          String?
  nasIpAddress      String
  nasPort           Int?
  nasPortType       NASPortType?
  framedProtocol    FramedProtocol?
  serviceName       ServiceName?
  callingStationId  String?
  calledStationId   String?
  authProtocol      AuthProtocol?
  packetType        RadiusPacketType
  statusCode        Int?
  errorMessage      String?
  sessionTimeout    Int?
  idleTimeout       Int?
  bytesIn           BigInt           @default(0)
  bytesOut          BigInt           @default(0)
  packetsIn         BigInt           @default(0)
  packetsOut        BigInt           @default(0)
  imsi              String?
  apn               String?
  sessionStatus     SessionStatus    @default(ACTIVE)
  startedAt         DateTime         @default(now())
  lastActivityAt    DateTime         @default(now())
  terminatedAt      DateTime?

  @@index([sessionId])
  @@index([userName])
  @@index([nasIpAddress])
  @@index([sessionStatus])
  @@map("radius_sessions")
}

enum NASPortType {
  WIRELESS_80211
  ETHERNET
  ADSL
  GPRS_UMTS
  CDMA2000
  LTE_EUTRAN
  NR_5G
  WIMAX
  XDSL
  VPN
  OTHER
}

enum FramedProtocol {
  PPP
  SLIP
  ARAP
  GPRS_PPP
  OTHER
}

enum ServiceName {
  FRAMED_USER
  LOGIN_USER
  OUTBOUND_USER
  ADMINISTRATOR
  NAS_PROMPT
  AUTHENTICATE_ONLY
  CALLBACK_LOGIN
  CALLBACK_FRAMED
  OTHER
}

enum AuthProtocol {
  PAP
  CHAP
  MSCHAP
  MSCHAPV2
  EAP
  OTHER
}

enum RadiusPacketType {
  ACCESS_REQUEST
  ACCESS_ACCEPT
  ACCESS_REJECT
  ACCESS_CHALLENGE
  ACCOUNTING_REQUEST
  ACCOUNTING_RESPONSE
  SERVER_COA_REQUEST
  SERVER_COA_ACK
  SERVER_COA_NAK
  DISCONNECT_REQUEST
  DISCONNECT_ACK
  DISCONNECT_NAK
}

model SIPSession {
  id                String           @id @default(cuid())
  callId            String           @unique
  fromUri           String
  toUri             String
  fromUser          String?
  toUser            String?
  fromDomain        String?
  toDomain         String?
  callType          SIPCallType      @default(VOICE)
  callDirection     CallDirection    @default(INCOMING)
  inviteTimestamp   DateTime?
  tryTimestamp      DateTime?
  ringingTimestamp  DateTime?
  connectTimestamp  DateTime?
  disconnectTimestamp DateTime?
  disconnectReason  String?
  durationSeconds   Int              @default(0)
  sourceIp          String
  destIp            String
  sourcePort        Int?
  destPort          Int?
  sipMethod         SIPMethod?
  responseCode      Int?
  userAgent         String?
  isEncrypted       Boolean          @default(false)
  srtpEnabled       Boolean          @default(false)
  isIntercepted     Boolean          @default(false)
  interceptionType  String?
  fraudIndicators   String?
  anomalyScore      Float            @default(0.0)
  sourceNeId        String?
  destNeId          String?
  createdAt         DateTime         @default(now())

  @@index([callId])
  @@index([fromUser])
  @@index([toUser])
  @@index([callType])
  @@index([connectTimestamp])
  @@map("sip_sessions")
}

enum SIPCallType {
  VOICE
  VIDEO
  SMS_OVER_SIP
  INSTANT_MESSAGE
  PRESENCE
  CONFERENCE
  OTHER
}

enum CallDirection {
  INCOMING
  OUTGOING
  INTERNAL
  TRANSIT
}

enum SIPMethod {
  INVITE
  ACK
  BYE
  CANCEL
  OPTIONS
  REGISTER
  PRACK
  SUBSCRIBE
  NOTIFY
  PUBLISH
  INFO
  REFER
  MESSAGE
  UPDATE
}

// ============================================================
// DOMAIN 5: COMPLIANCE & AUDIT
// ============================================================

model AuditLog {
  id            String       @id @default(cuid())
  userId        String?
  action        String
  resource      String
  resourceId    String?
  oldValue      String?
  newValue      String?
  ipAddress     String?
  userAgent     String?
  severity      AuditSeverity @default(INFO)
  category      AuditCategory @default(GENERAL)
  outcome       AuditOutcome  @default(SUCCESS)
  errorMessage  String?
  metadata      String?
  createdAt     DateTime     @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@index([category])
  @@map("audit_logs")
}

enum AuditSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum AuditCategory {
  AUTHENTICATION
  AUTHORIZATION
  DATA_ACCESS
  DATA_MODIFICATION
  SYSTEM_CONFIG
  INCIDENT_MANAGEMENT
  THREAT_INTEL
  COMPLIANCE
  SECURITY_EVENT
  GENERAL
}

enum AuditOutcome {
  SUCCESS
  FAILURE
  DENIED
  ERROR
  PARTIAL
}

model Report {
  id            String       @id @default(cuid())
  title         String
  description   String?
  reportType    ReportType   @default(INCIDENT_SUMMARY)
  format        ReportFormat @default(PDF)
  status        ReportStatus @default(GENERATING)
  generatedBy   String?
  parameters    String?
  filePath      String?
  fileSize      Int?
  schedule      ReportSchedule?
  recipients    String?
  dateRangeStart DateTime?
  dateRangeEnd   DateTime?
  createdAt     DateTime     @default(now())
  completedAt   DateTime?

  @@index([reportType])
  @@index([status])
  @@index([generatedBy])
  @@index([createdAt])
}

enum ReportType {
  INCIDENT_SUMMARY
  ALERT_TRENDS
  THREAT_LANDSCAPE
  KPI_DASHBOARD
  COMPLIANCE_STATUS
  SLA_REPORT
  TEAM_PERFORMANCE
  THREAT_ACTOR_PROFILE
  TELECOM_FRAUD
  ROAMING_ANALYSIS
  EXECUTIVE_SUMMARY
  CUSTOM
}

enum ReportFormat {
  PDF
  HTML
  CSV
  JSON
  XLSX
  DOCX
}

enum ReportStatus {
  GENERATING
  COMPLETED
  FAILED
  SCHEDULED
  EXPIRED
}

enum ReportSchedule {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  ON_DEMAND
}

model SystemConfig {
  id            String    @id @default(cuid())
  key           String    @unique
  value         String
  description   String?
  category      ConfigCategory @default(GENERAL)
  isSensitive   Boolean   @default(false)
  validationRule String?
  lastModifiedBy String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([category])
  @@map("system_config")
}

enum ConfigCategory {
  GENERAL
  SECURITY
  INTEGRATION
  NOTIFICATION
  COMPLIANCE
  PERFORMANCE
  BACKUP
  TELECOM
  THREAT_INTEL
  UI_SETTINGS
}

model DataRetentionPolicy {
  id                  String              @id @default(cuid())
  entityType          RetentionEntityType
  retentionPeriodDays Int                 @default(365)
  actionAfterExpiry   RetentionAction     @default(ARCHIVE)
  storageTier         StorageTier         @default(HOT)
  legalHold           Boolean             @default(false)
  complianceRequirements String?
  customRules         String?
  isEnabled           Boolean             @default(true)
  lastRun             DateTime?
  nextRun             DateTime?
  recordsAffected     BigInt              @default(0)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([entityType])
  @@index([isEnabled])
  @@map("data_retention_policies")
}

enum RetentionEntityType {
  ALERTS
  INCIDENTS
  AUDIT_LOGS
  RAW_LOGS
  SESSION_DATA
  PCAP_FILES
  EVIDENCE
  THREAT_INTEL
  METRICS
  REPORTS
  TELECOM_SESSIONS
  SS7_MESSAGES
  SIP_CDRS
  ALL
}

enum RetentionAction {
  DELETE
  ARCHIVE
  ANONYMIZE
  AGGREGATE
  MOVE_TO_COLD
}

enum StorageTier {
  HOT
  WARM
  COLD
  GLACIER
}

// ============================================================
// DOMAIN: FRAUD DETECTION (Telecom Security)
// ============================================================

model FraudCase {
  id                String           @id @default(cuid())
  caseNumber        String           @unique
  type              String           // SIM_SWAP, IRSF, WANGIRI, PBX_HIJACKING, etc.
  severity          String           // LOW, MEDIUM, HIGH, CRITICAL
  status            String           @default("OPEN") // OPEN, INVESTIGATING, ESCALATED, RESOLVED, CLOSED
  confidence        Int              @default(0) // 0-100
  description       String?
  subscriberId      String?
  
  // Evidence & Impact
  evidence          String?                              // JSON array of evidence items
  estimatedLossDZD  Float?                                 // Estimated financial loss in Dinar
  
  // ARTP Compliance
  artpReportable    Boolean          @default(false)
  artpDeadline      DateTime?       // Must report within 24h
  
  // Assignment & Resolution
  assignedTo        String?
  resolvedAt        DateTime?
  resolutionNotes   String?
  metadata          String?                               // Additional metadata as JSON
  
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([caseNumber])
  @@index([type])
  @@index([severity])
  @@index([status])
  @@index([subscriberId])
  @@index([artpReportable])
  @@index([createdAt])
}

model FraudRule {
  id                String           @id @default(cuid())
  name              String
  fraudType         String           // Maps to FraudCase.type
  enabled           Boolean          @default(true)
  severity          String           // LOW, MEDIUM, HIGH, CRITICAL
  conditions        String?                               // JSON array of rule conditions
  actions           String?                                // JSON array of actions to take
  artpReportable    Boolean          @default(false)
  cooldownMinutes   Int              @default(60)
  hitCount          Int              @default(0)
  lastHitAt         DateTime?
  enabledBy         String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([fraudType])
  @@index([enabled])
}
