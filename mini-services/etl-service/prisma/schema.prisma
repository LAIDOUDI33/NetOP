generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../../db/custom.db"
}

model DataPipeline {
  id               String              @id @default(cuid())
  name             String
  description      String              @default("")
  source           String
  target           String
  schedule         String
  status           String              @default("active")
  lastRun          DateTime?
  nextRun          DateTime?
  recordsProcessed Int                 @default(0)
  errorRate        Float               @default(0)
  avgDurationMs    Int                 @default(0)
  transformationSteps String            @default("[]")
  retryMaxAttempts Int                 @default(3)
  retryDelayMs     Int                 @default(5000)
  totalRuns        Int                 @default(0)
  successRuns      Int                 @default(0)
  failedRuns       Int                 @default(0)
  totalRecordsIn   Int                 @default(0)
  totalRecordsOut  Int                 @default(0)
  totalRecordsErr  Int                 @default(0)
  enabled          Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  executions       PipelineExecution[]
  qualityResults   DataQualityResult[]

  @@index([status])
  @@index([source])
  @@index([target])
  @@index([enabled])
}

model PipelineExecution {
  id               String      @id @default(cuid())
  pipelineId       String
  pipeline         DataPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  status           String      @default("running")
  triggerType      String      @default("scheduled")
  recordsIn        Int         @default(0)
  recordsOut       Int         @default(0)
  recordsError     Int         @default(0)
  errorRate        Float       @default(0)
  startedAt        DateTime    @default(now())
  completedAt      DateTime?
  durationMs       Int         @default(0)
  errorMessage     String?
  errorStack       String?
  retryCount       Int         @default(0)
  maxRetries       Int         @default(3)
  stepResults      String      @default("[]")
  metadata         String      @default("{}")
  createdAt        DateTime    @default(now())

  @@index([pipelineId])
  @@index([status])
  @@index([startedAt])
  @@index([triggerType])
}

model DataQualityRule {
  id              String   @id @default(cuid())
  name            String
  description     String   @default("")
  targetModel     String
  ruleType        String
  ruleConfig      String   @default("{}")
  severity        String   @default("warning")
  isEnabled       Boolean  @default(true)
  lastEvaluatedAt DateTime?
  lastPassRate    Float    @default(0)
  totalEvaluations Int     @default(0)
  totalPasses     Int      @default(0)
  totalFailures   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  results         DataQualityResult[]

  @@index([targetModel])
  @@index([ruleType])
  @@index([severity])
  @@index([isEnabled])
}

model DataQualityResult {
  id              String           @id @default(cuid())
  ruleId          String
  rule            DataQualityRule  @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  pipelineId      String?
  pipeline        DataPipeline?    @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  executionId     String?
  passed          Boolean          @default(true)
  actualValue     Float            @default(0)
  expectedValue   Float            @default(0)
  evaluatedAt     DateTime         @default(now())
  details         String           @default("{}")
  createdAt       DateTime         @default(now())

  @@index([ruleId])
  @@index([pipelineId])
  @@index([evaluatedAt])
  @@index([passed])
}
