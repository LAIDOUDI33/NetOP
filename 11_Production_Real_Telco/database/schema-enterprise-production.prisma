// ============================================================
// Djezzy National SOC Platform - Enterprise Production Schema
// Version: 11.0.0 (Phase 11 - Full Telco Production Ready)
// Database: PostgreSQL 16+ (Production)
// Capacity: 15M+ Subscribers | 50B+ Events/Year | 80B+ CDRs/Year
// Features: Partitioning, Sharding, Full-Text Search, Row-Level Security
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// DOMAIN 1: AUTHENTICATION & AUTHORIZATION (Enterprise RBAC + ABAC)
// ============================================================

model User {
  id                String           @id @default(cuid())
  email             String           @unique
  username          String           @unique
  passwordHash      String?
  name              String
  avatarUrl         String?
  isActive          Boolean          @default(true)
  isMfaEnabled      Boolean          @default(false)
  mfaSecret         String?
  lastLoginAt       DateTime?
  passwordChangedAt DateTime         @default(now())
  roleId            String
  
  // Corporate Identity Integration
  employeeId        String?          @unique @map("employee_id")
  department        String?
  costCenter        String?          @map("cost_center")
  managerId         String?          @map("manager_id")
  
  // LDAP/AD Integration
  ldapDN            String?          @map("ldap_dn")
  ldapGUID          String?          @unique @map("ldap_guid")
  adSid             String?          @unique @map("ad_sid")
  
  // Session Management
  lastIpAddress     String?          @map("last_ip_address")
  lastUserAgent     String?          @map("last_user_agent")
  failedLoginCount  Int              @default(0) @map("failed_login_count")
  lockedUntil       DateTime?        @map("locked_until")

  // Audit timestamps
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  createdBy         String?          @map("created_by")
  updatedBy         String?          @map("updated_by")
  deletedAt         DateTime?        @map("deleted_at") // Soft delete

  // Relations
  role              Role             @relation(fields: [roleId], references: [id])
  sessions          UserSession[]
  auditLogs         AuditLog[]
  incidentsCreated  Incident[]       @relation("IncidentCreator")
  incidentsAssigned Incident[]       @relation("IncidentAssignee")
  tasksAssigned     Task[]           @relation("TaskAssignee")
  tasksCreated      Task[]           @relation("TaskCreator")
  evidenceUploaded  Evidence[]       @relation("EvidenceUploader")
  comments          Comment[]        @relation("CommentAuthor")
  apiKeys           ApiKey[]

  @@index([roleId])
  @@index([department])
  @@index([isActive])
  @@index([createdAt])
  @@map("users")
}

model Role {
  id                String           @id @default(cuid())
  name              String           @unique
  description       String?
  level             Int              // Hierarchy: 1=Viewer, 2=Analyst, 3=SeniorAnalyst, 4=TeamLead, 5=IncidentCommander, 6=Admin
  permissions       Json             @default("[]") // Array of permission strings
  isSystemRole      Boolean          @default(false) @map("is_system_role")
  
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  users             User[]

  @@map("roles")
}

model UserSession {
  id                String           @id @default(cuid())
  userId            String
  tokenHash         String           @map("token_hash")
  refreshTokenHash  String?          @map("refresh_token_hash")
  ipAddress         String           @map("ip_address")
  userAgent         String           @map("user_agent")
  isActive          Boolean          @default(true)
  expiresAt         DateTime         @map("expires_at")
  
  createdAt         DateTime         @default(now())
  revokedAt         DateTime?        @map("revoked_at")

  user              User             @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([tokenHash])
  @@index([isActive])
  @@index([expiresAt])
  @@map("user_sessions")
}

model ApiKey {
  id                String           @id @default(cuid())
  name              String
  keyHash           String           @map("key_hash") // SHA-256 hash of API key
  prefix            String           // First 8 chars for identification
  userId            String
  permissions       Json             @default("[]")
  scopes            String[]         @default(["read"])
  rateLimit         Int              @default(1000) // Requests per minute
  lastUsedAt        DateTime?        @map("last_used_at")
  ipAddress         String?          @map("ip_address") // Whitelist (null = any)
  isActive          Boolean          @default(true)
  expiresAt         DateTime?        @map("expires_at")
  
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  revokedAt         DateTime?        @map("revoked_at")

  user              User             @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([keyHash])
  @@index([prefix])
  @@index([isActive])
  @@map("api_keys")
}

// ============================================================
// DOMAIN 2: SECURITY EVENTS (Partitioned for High Volume)
// Note: PostgreSQL partitioning configured via raw SQL migrations
// ============================================================

model SecurityEvent {
  id                String           @id @default(cuid())
  eventId           String           @unique @map("event_id") // External event ID from source
  
  // Event Classification
  eventType         String           @map("event_type") // authentication, network, endpoint, application, cloud, telecom
  category          String           // intrusion, malware, policy_violation, anomaly, reconnaissance
  severity          String           // critical, high, medium, low, informational
  status            String           @default("new") // new, triaged, investigating, closed, false_positive
  
  // Source Information
  sourceIp          String?          @map("source_ip")
  destinationIp     String?          @map("destination_ip")
  sourcePort        Int?             @map("source_port")
  destinationPort   Int?             @map("destination_port")
  protocol          String?
  sourceHost        String?          @map("source_host")
  destinationHost   String?          @map("destination_host")
  
  // Tool/Source Origin
  toolName          String           @map("tool_name") // wazuh, suricata, zeek, splunk, etc.
  toolSeverity      String?          @map("tool_severity") // Original severity from source tool
  ruleId            String?          @map("rule_id") // Original rule/signature ID
  ruleName          String?          @map("rule_name") // Human-readable rule name
  ruleCategory      String?          @map("rule_category") // MITRE ATT&CK tactic
  
  // Event Details
  title             String
  description       String?          @db.Text
  metadata          Json?            // Flexible JSON for additional data
  rawLog            String?          @db.Text // Original log line
  
  // Telecom-Specific Fields
  subscriberId      String?          @map("subscriber_id") // MSISDN reference
  imsi              String?          // IMSI if available
  imei              String?          // Device IMEI
  cellId            String?          @map("cell_id") // Cell tower identifier
  lac               String?          // Location Area Code
  
  // Correlation & Investigation
  incidentId        String?          @map("incident_id") // Linked incident if any
  iocMatched        String?          @map("ioc_matched") // Matched IOC hash/reference
  correlationGroup  String?          @map("correlation_group") // Group ID for correlated events
  confidence        Float?           @default(0.0) // 0.0-1.0 confidence score
  
  // Enrichment
  geoLocation       Json?            @map("geo_location") // {country, city, lat, lon}
  threatIntel       Json?            @map("threat_intel") // Enrichment from TI feeds
  assetInfo         Json?            @map("asset_info") // Asset inventory enrichment
  
  // Processing Metadata
  processedAt       DateTime         @map("processed_at") @default(now())
  ingestedAt        DateTime         @map("ingested_at") @default(now()) // Original event timestamp
  firstSeenAt       DateTime         @map("first_seen_at") @default(now())
  lastSeenAt       DateTime         @map("last_seen_at") @default(now())
  count             Int              @default(1) // Deduplication count
  
  // Audit
  assignedTo        String?          @map("assigned_to") // Analyst user ID
  assignedAt        DateTime?        @map("assigned_at")
  triagedBy         String?          @map("triaged_by")
  triagedAt         DateTime?        @map("triaged_at")
  closedBy          String?          @map("closed_by")
  closedAt         DateTime?        @map("closed_at")
  closureReason     String?          @map("closure_reason")
  
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  // Relations
  incident          Incident?        @relation(fields: [incidentId], references: [id])
  tags              SecurityEventTag[]

  // Indexes for query performance
  @@index([eventType])
  @@index([severity])
  @@index([status])
  @@index([sourceIp])
  @@index([destinationIp])
  @@index([toolName])
  @@index([ruleId])
  @@index([ingestedAt]) // Primary partition column
  @@index([processedAt])
  @@index([incidentId])
  @@index([assignedTo])
  @@index([correlationGroup])
  @@fulltext([title, description])
  @@map("security_events")
}

model SecurityEventTag {
  securityEventId   String           @map("security_event_id")
  tagId             String
  
  securityEvent     SecurityEvent    @relation(fields: [securityEventId], references: [id], onDelete: Cascade)
  tag               Tag              @relation(fields: [tagId], references: [id])

  @@id([securityEventId, tagId])
  @@map("security_event_tags")
}

model Tag {
  id                String           @id @default(cuid())
  name              String           @unique
  color             String?          // Hex color code
  category          String?          // classification, confidence, source, custom
  description       String?
  
  createdAt         DateTime         @default(now())

  events            SecurityEventTag[]
  incidents         IncidentTag[]

  @@map("tags")
}

// ============================================================
// DOMAIN 3: INCIDENT MANAGEMENT (Full IR Lifecycle)
// ============================================================

model Incident {
  id                String           @id @default(cuid())
  incidentNumber    String           @unique @map("incident_number") // Auto-generated: INC-20260728-0001
  
  // Classification
  title             String
  description       String           @db.Text
  type              String           // malware, data_breach, ddos, insider_threat, sim_swap_fraud, apt, phishing, policy_violation, other
  severity          String           // critical, high, medium, low
  status            String           @default("open") // open, contained, eradicated, recovery, closed, post_incident
  phase             String           @default("detection") // detection, analysis, containment, eradication, recovery, lessons_learned
  
  // MITRE ATT&CK Mapping
  tactics           String[]         @default([]) // MITRE tactics
  techniques        String[]         @default([]) // MITRE technique IDs
  
  // Timeline
  detectedAt        DateTime         @map("detected_at")
  occurredAt        DateTime?        @map("occurred_at") // When the incident actually started
  containmentTarget DateTime?       @map("containment_target") // SLA target
  resolutionTarget  DateTime?       @map("resolution_target") // SLA target
  resolvedAt        DateTime?        @map("resolved_at")
  closedAt          DateTime?        @map("closed_at")
  
  // Impact Assessment
  confidentialityImpact String?      @map("confidentiality_impact") // none, low, medium, high
  integrityImpact    String?         @map("integrity_impact")
  availabilityImpact String?        @map("availability_impact")
  assetsAffected    Int              @default(0) @map("assets_affected")
  subscribersAffected Int?          @map("subscribers_affected") // Telecom-specific
  revenueImpact      Decimal?        @map("revenue_impact") @db.Decimal(15, 2)
  
  // Assignment & Escalation
  commanderId       String?          @map("commander_id") // Incident Commander
  createdById       String           @map("created_by")
  assignedTeam      String?          @map("assigned_team") // SOC, Fraud, NOC, Legal, PR
  escalationLevel   Int              @default(1) @map("escalation_level") // 1=L1, 2=L2, 3=L3, 4=Executive
  priorityScore     Float?           @map("priority_score") // Calculated based on severity + impact + intel
  
  // External Coordination
  isPublic          Boolean          @default(false) @map("is_public")
  externalRef       String?          @map("external_ref") // External ticket/case number
  lawEnforcement    Boolean          @default(false) @map("law_enforcement")
  regulatoryNotice  Boolean          @default(false) @map("regulatory_notice") // ARPT notification required/arptNotified
  arptReportedAt    DateTime?        @map("arpt_reported_at")
  
  // Communication
  statusUpdate      String?          @db.Text @map("status_update") // Latest status narrative
  lessonsLearned    String?          @db.Text @map("lessons_learned")
  afterActionReport String?          @db.Text @map("after_action_report")
  
  // Metrics
  mttDetect         Int?             @map("mtt_detect") // Minutes to detect
  mttRespond        Int?             @map("mtt_respond") // Minutes to respond
  mttContain        Int?             @map("mtt_contain") // Minutes to contain
  totalCost         Decimal?         @db.Decimal(15, 2) @map("total_cost")
  
  // Audit
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  createdBy         User             @relation("IncidentCreator", fields: [createdById], references: [id])
  assignedTo        User?            @relation("IncidentAssignee", fields: [commanderId], references: [id])
  deletedAt         DateTime?        @map("deleted_at")

  // Relations
  events            SecurityEvent[]  @relation("IncidentLinkedEvents")
  tasks             Task[]
  evidence          Evidence[]
  timelineEntries   TimelineEntry[]
  comments          Comment[]
  tags              IncidentTag[]
  playbooks         IncidentPlaybook[]

  @@index([status])
  @@index([severity])
  @@index([type])
  @@index([commanderId])
  @@index([createdById])
  @@index([detectedAt])
  @@index([assignedTeam])
  @@index([escalationLevel])
  @@fulltext([title, description])
  @@map("incidents")
}

model IncidentTag {
  incidentId        String           @map("incident_id")
  tagId             String
  
  incident          Incident         @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  tag               Tag              @relation(fields: [tagId], references: [id])

  @@id([incidentId, tagId])
  @@map("incident_tags")
}

model Task {
  id                String           @id @default(cuid())
  incidentId        String           @map("incident_id")
  title             String
  description       String?          @db.Text
  type              String           // analysis, containment, eradication, recovery, documentation, communication, coordination
  status            String           @default("pending") // pending, in_progress, blocked, completed, cancelled
  priority          String           @default("medium") // critical, high, medium, low
  
  // Assignment
  assignedTo        String?          @map("assigned_to")
  createdById       String           @map("created_by")
  
  // Timing
  dueAt             DateTime?        @map("due_at")
  completedAt       DateTime?        @map("completed_at")
  estimatedHours    Decimal?         @db.Decimal(5, 2) @map("estimated_hours")
  actualHours       Decimal?         @db.Decimal(5, 2) @map("actual_hours")
  
  // Dependencies
  dependsOn         String[]         @default([]) @map("depends_on") // Task IDs this depends on
  blockingFor       String[]         @default([]) @map("blocking_for") // Tasks blocked by this
  
  // Results
  output            String?          @db.Text // Task output/deliverable
  artifacts         Json?            // References to evidence/files
  
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  incident          Incident         @relation("IncidentTasks", fields: [incidentId], references: [id], onDelete: Cascade)
  assignee          User?            @relation("TaskAssignee", fields: [assignedTo], references: [id])
  creator           User             @relation("TaskCreator", fields: [createdById], references: [id])

  @@index([incidentId])
  @@index([assignedTo])
  @@index([status])
  @@index([priority])
  @@index([dueAt])
  @@map("tasks")
}

model Evidence {
  id                String           @id @default(cuid())
  incidentId        String           @map("incident_id")
  
  filename          String
  originalFilename  String           @map("original_filename")
  fileSize          BigInt           @map("file_size") // Bytes
  mimeType          String           @map("mime_type")
  fileHashSha256    String           @map("file_hash_sha256")
  fileHashMd5       String?          @map("file_hash_md5")
  
  description       String?          @db.Text
  type              String           // log, pcap, memory_image, disk_image, screenshot, document, malware_sample, other
  classification    String?          // public, internal, confidential, restricted
  chainOfCustody    Boolean          @default(false) @map("chain_of_custody")
  
  // Storage
  storagePath       String           @map("storage_path") // Object storage path
  storageProvider   String           @map("storage_provider") // local, s3, azure, gcs
  isEncrypted       Boolean          @default(false) @map("is_encrypted")
  encryptionKeyId   String?          @map("encryption_key_id")
  
  // Collection Info
  collectedBy       String           @map("collected_by") // User or automated system
  collectionMethod  String?          @map("collection_method") // manual, grr_flow, edr_alert, siem_export
  collectedAt       DateTime         @map("collected_at") @default(now())
  sourceHost        String?          @map("source_host")
  timeRangeStart   DateTime?        @map("time_range_start")
  timeRangeEnd     DateTime?        @map("time_range_end")
  
  // Analysis
  analyzedAt        DateTime?        @map("analyzed_at")
  analysisResults  Json?            @map("analysis_results") // Sandbox, AV scan results
  iocsExtracted     Json?            @map("iocs_extracted") // Extracted IOCs
  
  uploadedById      String           @map("uploaded_by")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  incident          Incident         @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  uploader          User             @relation("EvidenceUploader", fields: [uploadedById], references: [id])

  @@index([incidentId])
  @@index([uploadedById])
  @@index([fileHashSha256])
  @@index([type])
  @@index([collectedAt])
  @@map("evidence")
}

model TimelineEntry {
  id                String           @id @default(cuid())
  incidentId        String           @map("incident_id")
  
  timestamp         DateTime         // When this event in the timeline occurred
  type              String           // detection, action, observation, decision, milestone, external
  title             String
  description       String?          @db.Text
  category          String?          // attacker, defender, victim, automated, unknown
  
  // Source
  source            String?          // analyst, system, automated_playbook, external
  sourceRef         String?          @map("source_ref") // Reference to source (task ID, event ID, etc.)
  
  // TTP Mapping
  tactic            String?          // MITRE ATT&CK tactic
  technique         String?          // MITRE ATT&CK technique ID
  
  // Artifacts
  artifacts         Json?            // Linked evidence, IOCs, indicators
  
  createdBy         String           @map("created_by")
  createdAt         DateTime         @default(now())

  incident          Incident         @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@index([timestamp])
  @@index([type])
  @@map("timeline_entries")
}

model Comment {
  id                String           @id @default(cuid())
  
  // Polymorphic relation (can be on Incident or Task)
  incidentId        String?          @map("incident_id")
  taskId            String?          @map("task_id")
  
  content           String           @db.Content
  isInternal        Boolean          @default(true) @map("is_internal") // False = visible to external stakeholders
  
  authorId          String           @map("author_id")
  parentId          String?          @map("parent_id") // For threaded replies
  mentions          String[]         @default([]) // User IDs mentioned (@username)
  attachments       Json?            // File attachment references
  
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?        @map("deleted_at")

  incident          Incident?        @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  task              Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author            User             @relation("CommentAuthor", fields: [authorId], references: [id])
  parent            Comment?         @relation("CommentReplies", fields: [parentId], references: [id])
  replies           Comment[]       @relation("CommentReplies")

  @@index([incidentId])
  @@index([taskId])
  @@index([authorId])
  @@index([parentId])
  @@index([createdAt])
  @@map("comments")
}

// ============================================================
// DOMAIN 4: THREAT INTELLIGENCE (IOC Management & TI Platform)
// ============================================================

model ThreatIntelFeed {
  id                String           @id @default(cuid())
  name              String           @unique
  description       String?          @db.Text
  type              String           // commercial, opensource, community, internal, government
  format            String           // stix/taxii, csv, json, xml, misp
  url               String?          // Feed URL or API endpoint
  apiKey            String?          @map("api_key") // Encrypted
  pollingInterval   Int              @default(3600) @map("polling_interval") // Seconds
  lastPolledAt      DateTime?        @map("polled_at")
  lastPollStatus    String?          @map("last_poll_status") // success, error, auth_failed
  lastPollMessage   String?          @map("last_poll_message")
  isActive          Boolean          @default(true) @map("is_active")
  
  // Quality Scoring
  reliabilityScore  Float            @default(0.5) @map("reliability_score") // 0.0-1.0 based on historical accuracy
  coverage          String[]         @default([]) // What types of IOCs it covers
  tlpDefault        String           @default("white") @map("tlp_default") // Traffic Light Protocol default
  
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  iocs              Ioc[]
  syncLogs          ThreatIntelSyncLog[]

  @@index([isActive])
  @@index([type])
  @@map("threat_intel_feeds")
}

model Ioc {
  id                String           @id @default(cuid())
  
  // IOC Value & Type
  value             String           // The actual indicator value
  type              String           // ipv4, ipv6, domain, url, email, md5, sha256, sha1, mutex, registry, ja3, ssl_cert_fingerprint, msisdn, imsi, imei, ssid, cve
  
  // Classification
  tlp               String           @default("white") // white, green, amber, red
  confidence        Float            @default(0.0) // 0.0-1.0
  severity          String?          // critical, high, medium, low
  
  // Description & Context
  description       String?          @db.Text
  threatTypes       String[]         @default([]) @map("threat_types") // malware, phishing, c2, scanner, exploitkit, etc.
  malwareFamilies   String[]         @default([]) @map("malware_families")
  attackPatterns   String[]         @default([]) @map("attack_patterns") // MITRE technique IDs
  campaigns         String[]         @default([]) // Known campaign names
  
  // Source Tracking
  feedId            String?          @map("feed_id") // Source feed
  sourceContext     Json?            @map("source_context") // Original context from feed
  firstSeenAt       DateTime         @map("first_seen_at") @default(now())
  lastSeenAt       DateTime         @map("last_seen_at") @default(now())
  expirationDate    DateTime?        @map("expiration_date") // When this IOC should be considered stale
  
  // State Management
  isActive          Boolean          @default(true) @map("is_active")
  falsePositive     Boolean          @default(false) @map("false_positive")
  falsePositiveReason String?        @map("false_positive_reason")
  whitelisted       Boolean          @default(false)
  whitelistReason   String?          @map("whitelist_reason")
  
  // Enrichment
  whoisData         Json?            @map("whois_data")
  geoData           Json?            @map("geo_data")
  passiveDns        Json?            @map("passive_dns")
  sandboxResults   Json?            @map("sandbox_results")
  relatedIocs       Json?            @map("related_iocs") // Pre-computed relationships
  
  // Matching Statistics
  matchCount        Int              @default(0) @map("match_count") // How many times matched in events
  lastMatchedAt     DateTime?        @map("last_matched_at")
  incidentsLinked   String[]         @default([]) @map("incidents_linked") // Incident IDs where this IOC appeared
  
  // Tags for Organization
  tags              String[]         @default([])
  
  // Audit
  createdBy         String?          @map("created_by")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  feed              ThreatIntelFeed? @relation(fields: [feedId], references: [id])
  matches           IocMatch[]

  @@index([value])
  @@index([type])
  @@index([tlp])
  @@index([isActive])
  @@index([falsePositive])
  @@index([firstSeenAt])
  @@index([lastSeenAt])
  @@index([expirationDate])
  @@unique([value, type]) // Prevent duplicate IOCs of same type
  @@fulltext([value, description])
  @@map("iocs")
}

model IocMatch {
  id                String           @id @default(cuid())
  iocId             String           @map("ioc_id")
  securityEventId   String           @map("security_event_id")
  
  matchConfidence   Float            @map("match_confidence") // 0.0-1.0
  matchContext      Json?            @map("match_context") // What field(s) matched
  
  matchedAt         DateTime         @map("matched_at") @default(now())

  ioc               Ioc              @relation(fields: [iocId], references: [id], onDelete: Cascade)
  securityEvent     SecurityEvent?   @relation(fields: [securityEventId], references: [id], onDelete: Cascade)

  @@index([iocId])
  @@index([securityEventId])
  @@index([matchedAt])
  @@map("ioc_matches")
}

model ThreatIntelSyncLog {
  id                String           @id @default(cuid())
  feedId            String           @map("feed_id")
  
  startedAt         DateTime         @map("started_at")
  completedAt       DateTime?        @map("completed_at")
  status            String           // running, success, error, partial
  itemsProcessed    Int              @map("items_processed")
  itemsNew          Int              @default(0) @map("items_new")
  itemsUpdated      Int              @default(0) @map("items_updated")
  itemsFailed       Int              @default(0) @map("items_failed")
  errorMessage      String?          @map("error_message")
  
  createdAt         DateTime         @default(now())

  feed              ThreatIntelFeed @relation(fields: [feedId], references: [id], onDelete: Cascade)

  @@index([feedId])
  @@index([startedAt])
  @@index([status])
  @@map("threat_intel_sync_logs")
}

// ============================================================
// DOMAIN 5: TELECOM-SPECIFIC DATA (CDR, Subscriber, Network)
// ============================================================

model Subscriber {
  id                String           @id @default(cuid())
  
  // Identity
  msisdn            String           @unique // Mobile Station International Subscriber Directory Number (phone number)
  imsi              String           @unique // International Mobile Subscriber Identity
  imei              String?          // International Mobile Equipment Identity
  
  // Profile
  subscriberType    String           @map("subscriber_type") // prepaid, postpaid, corporate, roaming, mvno
  status            String           @default("active") // active, suspended, terminated, fraud_investigation
  riskScore         Float            @default(0.0) @map("risk_score") // 0.0-1.0 calculated fraud/security risk
  
  // Service Information
  planType          String?          @map("plan_type")
  activationDate    DateTime?        @map("activation_date")
  lastActivityAt    DateTime?        @map("last_activity_at")
  
  // Location (last known)
  lastCellId        String?          @map("last_cell_id")
  lastLac           String?          @map("last_lac")
  lastVlr           String?          @map("last_vlr") // Visitor Location Register
  
  // Security Flags
  isRoaming         Boolean          @default(false) @map("is_roaming")
  simSwapCount      Int              @default(0) @map("sim_swap_count")
  lastSimSwapAt     DateTime?        @map("last_sim_swap_at")
  isHighValue       Boolean          @default(false) @map("is_high_value") // VIP/high-risk customer
  monitoringLevel   String           @default("standard") @map("monitoring_level") // standard, enhanced, intensive
  
  // Notes
  securityNotes     String?          @db.Text @map("security_notes")
  fraudFlags        String[]         @default([]) @map("fraud_flags")
  
  // Audit
  createdBy         String?          @map("created_by")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([msisdn])
  @@index([imsi])
  @@index([imei])
  @@index([status])
  @@index([riskScore])
  @@index([subscriberType])
  @@index([monitoringLevel])
  @@map("subscribers")
}

model CdrRecord {
  id                String           @id @default(cuid())
  cdrId             String           @unique @map("cdr_id") // Unique CDR identifier from switch
  
  // Call/Data Identifiers
  callId            String           @map("call_id")
  callingNumber     String           @map("calling_number")
  calledNumber      String           @map("called_number")
  imsiCalling       String?          @map("imsi_calling")
  imsiCalled        String?          @map("imsi_called")
  
  // Type & Timing
  recordType        String           @map("record_type") // voice_call, sms, data_session, roaming, ss7_signaling
  startTime         DateTime         @map("start_time")
  endTime           DateTime?        @map("end_time")
  durationSeconds   Int?             @map("duration_seconds")
  
  // Network Elements
  originatingSwitch String?         @map("originating_switch")
  terminatingSwitch String?         @map("terminating_switch")
  servingMsc        String?          @map("serving_msc")
  servingVlr        String?          @map("serving_vlr")
  
  // Location
  callingCellId     String?          @map("calling_cell_id")
  callingLac        String?          @map("calling_lac")
  calledCellId      String?          @map("called_cell_id")
  calledLac         String?          @map("called_lac")
  
  // Data Specific
  dataVolumeUp      BigInt?          @map("data_volume_up") // Bytes
  dataVolumeDown    BigInt?          @map("data_volume_down") // Bytes
  apn              String?          // Access Point Name
  
  // Roaming
  isRoaming         Boolean          @default(false) @map("is_roaming")
  roamingPartner    String?          @map("roaming_partner")
  visitedCountry   String?          @map("visited_country")
  visitedNetwork   String?          @map("visited_network")
  
  // Charging
  chargeAmount      Decimal?         @db.Decimal(10, 2) @map("charge_amount")
  currency          String?          @default("DZD")
  
  // Fraud/Security Markers
  fraudIndicators   String[]         @default([]) @map("fraud_indicators")
  riskFlagged       Boolean          @default(false) @map("risk_flagged")
  securityReviewRequired Boolean      @default(false) @map("security_review_required")
  
  // Raw CDR Data
  rawCdr            Json?            @map("raw_cdr") // Complete original CDR as JSON
  
  createdAt         DateTime         @default(now())

  @@index([callId])
  @@index([callingNumber])
  @@index([calledNumber])
  @@index([imsiCalling])
  @@index([startTime])
  @@index([recordType])
  @@index([originatingSwitch])
  @@index([isRoaming])
  @@index([riskFlagged])
  @@index([securityReviewRequired])
  @@map("cdr_records")
}

model SimSwapEvent {
  id                String           @id @default(cuid())
  
  subscriberId      String           @map("subscriber_id") // MSISDN
  oldImsi           String           @map("old_imsi")
  newImsi           String           @map("new_imsi")
  oldSimSerial      String?          @map("old_sim_serial")
  newSimSerial      String?          @map("new_sim_serial")
  
  swapTime          DateTime         @map("swap_time")
  channel           String           // store, app, self_service, agent, fraud
  
  // Verification
  verificationMethod String?        @map("verification_method")
  verifiedIdentity  Boolean          @default(false) @map("verified_identity")
  
  // Risk Assessment
  riskScore         Float            @default(0.0) @map("risk_score")
  riskFactors       String[]         @default([]) @map("risk_factors")
  isSuspicious      Boolean          @default(false) @map("is_suspicious")
  investigationStatus String?        @map("investigation_status") // none, under_review, confirmed_fraud, cleared
  
  // Reference
  incidentId        String?          @map("incident_id") // Linked fraud incident
  requestId         String?          @map("request_id") // Original request tracking ID
  
  // Location
  channelId         String?          @map("channel_id")
  terminalId        String?          @map("terminal_id")
  ipAddress         String?          @map("ip_address")
  
  createdAt         DateTime         @default(now())

  @@index([subscriberId])
  @@index([newImsi])
  @@index([swapTime])
  @@index([isSuspicious])
  @@index([investigationStatus])
  @@map("sim_swap_events")
}

// ============================================================
// DOMAIN 6: PLAYBOOKS & AUTOMATION (SOAR Integration)
// ============================================================

model Playbook {
  id                String           @id @default(cuid())
  name              String           @unique
  description       String?          @db.Text
  version           String           @default("1.0")
  category          String           // phishing, malware, ddos, data_breach, insider, sim_swap_fraud, apt, vulnerability, general
  severity          String?          // Applicable severity levels
  
  // Content
  triggerConditions Json             @map("trigger_conditions") // When to auto-execute
  steps             Json             // Ordered array of playbook steps
  expectedDuration  Int?             @map("expected_duration") // Minutes
  
  // Execution Settings
  isAutoExecutable  Boolean          @default(false) @map("auto_executable")
  requiresApproval  Boolean          @default(true) @map("requires_approval")
  approvalThreshold Int?             @map("approval_threshold") // Role level required
  
  // Status
  isActive          Boolean          @default(true) @map("is_active")
  isDraft           Boolean          @default(true) @map("is_draft")
  
  // Metrics
  totalRuns         Int              @default(0) @map("total_runs")
  successfulRuns    Int              @default(0) @map("successful_runs")
  avgRuntime        Int?             @map("avg_runtime") // Seconds
  
  createdBy         String           @map("created_by")
  reviewedBy        String?          @map("reviewed_by")
  reviewedAt        DateTime?        @map("reviewed_at")
  
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  runs              PlaybookRun[]
  incidents         IncidentPlaybook[]

  @@index([category])
  @@index([isActive])
  @@index([isAutoExecutable])
  @@map("playbooks")
}

model PlaybookRun {
  id                String           @id @default(cuid())
  playbookId        String           @map("playbook_id")
  incidentId        String?          @map("incident_id") // Optional: can run without incident
  
  status            String           @default("running") // running, completed, failed, cancelled, waiting_approval
  triggeredBy       String           @map("triggered_by") // User ID or 'automatic'
  triggeredAt       DateTime         @map("triggered_at") @default(now())
  completedAt       DateTime?        @map("completed_at")
  
  // Execution Context
  inputParameters   Json             @map("input_parameters")
  currentStep       Int              @default(0) @map("current_step")
  stepResults       Json?            @map("step_results") // Results from each step
  
  // Output
  output            Json?            // Final output/artifacts
  error             String?          @db.Text
  actionsTaken      Json?            @map("actions_taken") // Log of all actions taken
  
  // Approval
  approvalStatus    String?          @map("approval_status") // pending, approved, rejected
  approvedBy        String?          @map("approved_by")
  approvedAt        DateTime?        @map("approved_at")
  rejectionReason   String?          @map("rejection_reason")
  
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  playbook          Playbook         @relation(fields: [playbookId], references: [id], onDelete: Cascade)

  @@index([playbookId])
  @@index([incidentId])
  @@index([status])
  @@index([triggeredAt])
  @@map("playbook_runs")
}

model IncidentPlaybook {
  incidentId        String           @map("incident_id")
  playbookId        String           @map("playbook_id")
  
  appliedAt         DateTime         @map("applied_at") @default(now())
  appliedBy         String           @map("applied_by")
  status            String           @default("active") // active, completed, superseded
  
  incident          Incident         @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  playbook          Playbook         @relation(fields: [playbookId], references: [id], onDelete: Cascade)

  @@id([incidentId, playbookId])
  @@map("incident_playbooks")
}

// ============================================================
// DOMAIN 7: AUDIT & COMPLIANCE
// ============================================================

model AuditLog {
  id                String           @id @default(cuid())
  
  // Action
  action            String           // create, read, update, delete, login, logout, export, execute, approve
  entityType        String           @map("entity_type") // User, Incident, Event, IOC, etc.
  entityId          String           @map("entity_id")
  
  // Actor
  userId            String?          @map("user_id")
  ipAddress         String           @map("ip_address")
  userAgent         String?          @map("user_agent")
  sessionId         String?          @map("session_id")
  
  // Changes
  oldValue          Json?            @map("old_value")
  newValue          Json?            @map("new_value")
  sensitiveFields   String[]         @default([]) @map("sensitive_fields") // Fields containing PII
  
  // Context
  resourceId        String?          @map("resource_id") // Additional resource context
  description       String?          @db.Text
  
  // Result
  isSuccess         Boolean          @default(true) @map("is_success")
  errorMessage      String?          @map("error_message")
  
  timestamp         DateTime         @default(now())

  user              User?            @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([entityId])
  @@index([timestamp])
  @@index([ipAddress])
  @@map("audit_logs")
}

// ============================================================
// DOMAIN 8: SYSTEM CONFIGURATION & HEALTH
// ============================================================

model SystemConfig {
  id                String           @id @default(cuid())
  key               String           @unique
  value             Json
  type              String           // string, number, boolean, json
  category          String           // general, security, integration, ui, notification
  description       String?
  isSensitive       Boolean          @default(false) @map("is_sensitive") // Mask in UI
  isReadOnly        Boolean          @default(false) @map("is_read_only") // Cannot change via UI
  
  // Environment Override
  environment       String           @default("*") // *, development, staging, production (* = all)
  
  // Versioning
  version           Int              @default(1)
  previousValue     Json?            @map("previous_value")
  
  updatedBy         String?          @map("updated_by")
  updatedAt         DateTime         @updatedAt
  createdAt         DateTime         @default(now())

  @@index([category])
  @@index([environment])
  @@map("system_config")
}

model IntegrationHealth {
  id                String           @id @default(cuid())
  
  // Integration Identification
  name              String           @unique // wazuh, elasticsearch, thehive, cortex, misp, kafka, etc.
  type              String           // siem, edr, soar, ti, nsm, vuln, messaging, database
  category          String           // internal, external, cloud
  
  // Connection Info (encrypted)
  endpoint          String?          // URL/API endpoint (masked in responses)
  credentialsId     String?          @map("credentials_id") // Reference to secure credential store
  
  // Health Status
  status            String           @default("unknown") // healthy, degraded, unhealthy, unknown, disabled
  lastCheckAt       DateTime         @map("check_at") @default(now())
  responseTimeMs    Int?             @map("response_time_ms")
  uptimePercent    Float?           @map("uptime_percent")
  
  // Error Tracking
  consecutiveFailures Int            @default(0) @map("consecutive_failures")
  lastError         String?          @map("last_error") @db.Text
  lastErrorAt       DateTime?        @map("error_at")
  
  // Statistics
  requestsTotal     Int              @default(0) @map("requests_total")
  requestsSuccess   Int              @default(0) @map("requests_success")
  requestsFailed    Int              @default(0) @map("requests_failed")
  dataPointsIngested BigInt          @default(0) @map("data_points_ingested")
  
  // Configuration
  config            Json             // Integration-specific configuration
  isEnabled         Boolean          @default(true) @map("is_enabled")
  alertThreshold    Int              @default(3) @map("alert_threshold") // Alert after N failures
  
  // Maintenance
  maintenanceWindow Json?            @map("maintenance_window") // {start, end, reason}
  version           String?          // Connected tool version
  
  updatedAt         DateTime         @updatedAt
  createdAt         DateTime         @default(now())

  @@index([status])
  @@index([type])
  @@index([isEnabled])
  @@map("integration_health")
}

// ============================================================
// DOMAIN 9: NOTIFICATIONS & ALERTING
// ============================================================

model Notification {
  id                String           @id @default(cuid())
  
  // Recipient
  userId            String?          @map("user_id") // Null = system/broadcast
  channel           String           // email, sms, webhook, push, slack, teams, pagerduty
  recipientAddress  String           @map("recipient_address") // Email, phone, webhook URL
  
  // Content
  subject           String
  body              String           @db.Text
  bodyHtml          String?          @map("body_html")
  templateId        String?          @map("template_id")
  templateData      Json?            @map("template_data")
  
  // Priority & Type
  priority          String           @default("normal") // low, normal, high, urgent, critical
  category          String           // incident_assigned, incident_updated, system_alert, digest, mention, report_ready
  type              String           // transactional, marketing, system, alert
  
  // Status
  status            String           @default("pending") // pending, sent, delivered, failed, cancelled
  sendAttempts      Int              @default(0) @map("send_attempts")
  maxAttempts       Int              @default(3) @map("max_attempts")
  
  // Timing
  scheduledAt       DateTime?        @map("scheduled_at")
  sentAt            DateTime?         @map("sent_at")
  deliveredAt       DateTime?        @map("delivered_at")
  failedAt          DateTime?        @map("failed_at")
  nextRetryAt       DateTime?        @map("next_retry_at")
  
  // Error Handling
  errorCode         String?          @map("error_code")
  errorMessage      String?          @map("error_message")
  
  // Read Receipt
  readAt            DateTime?         @map("read_at")
  
  // Metadata
  relatedEntityType String?          @map("related_entity_type")
  relatedEntityId   String?          @map("related_entity_id")
  metadata          Json?
  
  createdBy         String?          @map("created_by")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([userId])
  @@index([channel])
  @@index([status])
  @@index([priority])
  @@index([scheduledAt])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id                String           @id @default(cuid())
  userId            String           @map("user_id")
  category          String           // Which notification categories
  channel           String           // email, sms, push, webhook, etc.
  isEnabled         Boolean          @default(true) @map("is_enabled")
  quietHoursEnabled Boolean          @default(false) @map("quiet_hours_enabled")
  quietHoursStart   String?          @map("quiet_hours_start") // HH:mm
  quietHoursEnd     String?          @map("quiet_hours_end") // HH:mm
  
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, category, channel])
  @@map("notification_preferences")
}
