# Dependencies (regenerate with: bun install)
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build cache (regenerate with: bun run dev)
/.next/
/out/

# Testing
/coverage

# Production
/build

# Database files
/db/
*.db
*.db-journal
*.db-wal
*.db-shm

# Misc
.DS_Store
*.pem

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# Vercel
.vercel

# TypeScript cache
*.tsbuildinfo
next-env.d.ts

# IDE
.vscode/
.idea/
.claude
.z-ai-config

# System skills (not project code)
/skills/

# Environment files (keep .env.example)
.env*
!.env.example

# Tool artifacts
/tool-results/
/agent-ctx/
*.zip
.zscripts/

# Dev artifacts
dev.log
dev.out.log
server.log
test
prompt
local-*
worklog.md
