# ═══════════════════════════════════════════════════════════════
# NetOP – Environment Configuration Template
# Copy this file to .env.production and fill in every value.
# ═══════════════════════════════════════════════════════════════

# ── Database (PostgreSQL) ──────────────────────────────────────
DATABASE_URL=postgresql://netop:CHANGE_ME@localhost:5432/netop?schema=public

# ── NextAuth ────────────────────────────────────────────────────
# ⚠️  MUST be changed to a strong random value (≥32 bytes).
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=change-me-in-production
NEXTAUTH_URL=https://netop.djezzy.dz

# ── Runtime ─────────────────────────────────────────────────────
NODE_ENV=production

# ── Logging ─────────────────────────────────────────────────────
# Minimum log level: debug | info | warn | error | fatal
LOG_LEVEL=info

# ── CORS ────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=https://netop.djezzy.dz

# ── Sentry (Observability) ─────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_RELEASE=netop@1.0.0

# ── SMTP (Notification Service) ────────────────────────────────
SMTP_HOST=smtp.djezzy.dz
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── SMS Gateway (Notification Service) ─────────────────────────
SMS_API_URL=
SMS_API_KEY=

# ── PostgreSQL (Docker) ─────────────────────────────────────────
POSTGRES_DB=netop
POSTGRES_USER=netop
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
