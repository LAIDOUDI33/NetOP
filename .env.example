# ═══════════════════════════════════════════════════════════════
# NetOP – Environment Configuration Template
# Copy this file to .env.production and fill in every value.
# ═══════════════════════════════════════════════════════════════

# ── Database ────────────────────────────────────────────────────
# SQLite (default for single-node deployments)
DATABASE_URL=file:./db/custom.db
# PostgreSQL example:
# DATABASE_URL=postgresql://user:password@host:5432/netop?schema=public

# ── NextAuth ────────────────────────────────────────────────────
# ⚠️  MUST be changed to a strong random value (≥32 bytes).
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=change-me-in-production

# Public URL of your application (no trailing slash).
# In production this should be your real domain, e.g.:
NEXTAUTH_URL=https://netop.yourdomain.com

# ── Runtime ─────────────────────────────────────────────────────
# Controls Prisma query logging (development only).
# Do NOT set to "development" in production.
NODE_ENV=production

# ── Logging ─────────────────────────────────────────────────────
# Minimum log level: debug | info | warn | error | fatal
# Default: info
LOG_LEVEL=info
